<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".view.home.HomeFragment">

    <TextView
        android:id="@+id/welcoming_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Halo, Zap!"
        android:textSize="28sp"
        android:textStyle="bold"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/ask_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Apa kabarmu hari ini?"
        android:textSize="18sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="4dp"

        app:layout_constraintTop_toBottomOf="@id/welcoming_txt"
        app:layout_constraintStart_toStartOf="@id/welcoming_txt"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_run_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        tools:listitem="@layout/item_run"
        app:layout_constraintTop_toBottomOf="@id/ask_txt"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:paddingBottom="100dp"
        android:clipToPadding="false"/>

<!--    <com.google.android.material.floatingactionbutton.FloatingActionButton-->
<!--        android:id="@+id/floating_btn_add_run"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_margin="16dp"-->
<!--        android:backgroundTint="@color/biru"-->
<!--        app:srcCompat="@drawable/ic_add"-->
<!--        app:tint="@android:color/white"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"/>-->

</androidx.constraintlayout.widget.ConstraintLayout>